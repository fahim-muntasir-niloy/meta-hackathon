{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate": "npm run generate:prompt",
    "predev": "npm run generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "generate:prompt": "openui generate src/lib/library.ts --out ../src/meta_hackathon/prompts/openui_prompt.md --no-interactive && rm ../src/meta_hackathon/prompts/openui_prompt.spec.json"
  },
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph-sdk": "^1.12.8",
    "@langchain/react": "^1.2.8",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "lucide-react": "^1.62.0",
    "next": "^16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@openuidev/cli": "0.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "@openuidev/lang-core": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
