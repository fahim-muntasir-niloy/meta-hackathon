# One origin for the whole app (ngrok's free plan gives one domain):
#   /api/*  → Agent Server, prefix stripped (REST, SSE chat stream, voice WebSocket)
#   else    → Next.js
# Caddy streams SSE and upgrades WebSockets on its own.
:80 {
	handle_path /api/* {
		reverse_proxy backend:2024
	}
	handle {
		reverse_proxy frontend:3000
	}
}
